{
  "name": "@allahbin/tiptap",
  "version": "1.2.2",
  "description": "基于tiptap的中文文章编辑器",
  "homepage": "https://github.com/Tzng/allahbin-tiptap",
  "license": "MIT",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "father build",
    "build:watch": "father dev",
    "deploy": "gh-pages -d docs-dist",
    "dev": "dumi dev",
    "docs:build": "dumi build",
    "doctor": "father doctor",
    "lint": "npm run lint:es && npm run lint:css",
    "lint:css": "stylelint \"{src,test}/**/*.{css,less}\"",
    "lint:es": "eslint \"{src,test}/**/*.{js,jsx,ts,tsx}\"",
    "prepare": "husky install && dumi setup",
    "prepublishOnly": "father doctor && npm run build",
    "publishNpm": "father doctor && npm run build && npm publish --access public --registry=https://registry.npmjs.org/",
    "start": "npm run dev"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*.{md,json}": [
      "prettier --write --no-error-on-unmatched-pattern"
    ],
    "*.{css,less}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --parser=typescript --write"
    ]
  },
  "resolutions": {
    "lowlight": "2.9.0"
  },
  "dependencies": {
    "@tippyjs/react": "^4.2.6",
    "@tiptap/core": "^3.20.4",
    "@tiptap/extension-blockquote": "^3.20.4",
    "@tiptap/extension-bold": "^3.20.4",
    "@tiptap/extension-bullet-list": "^3.20.4",
    "@tiptap/extension-code": "^3.20.4",
    "@tiptap/extension-code-block": "^3.20.4",
    "@tiptap/extension-document": "^3.20.4",
    "@tiptap/extension-dropcursor": "^3.20.4",
    "@tiptap/extension-gapcursor": "^3.20.4",
    "@tiptap/extension-hard-break": "^3.20.4",
    "@tiptap/extension-heading": "^3.20.4",
    "@tiptap/extension-history": "^3.20.4",
    "@tiptap/extension-horizontal-rule": "^3.20.4",
    "@tiptap/extension-image": "^3.20.4",
    "@tiptap/extension-italic": "^3.20.4",
    "@tiptap/extension-link": "^3.20.4",
    "@tiptap/extension-list": "^3.20.4",
    "@tiptap/extension-list-item": "^3.20.4",
    "@tiptap/extension-ordered-list": "^3.20.4",
    "@tiptap/extension-paragraph": "^3.20.4",
    "@tiptap/extension-strike": "^3.20.4",
    "@tiptap/extension-table": "^3.20.4",
    "@tiptap/extension-table-cell": "^3.20.4",
    "@tiptap/extension-table-header": "^3.20.4",
    "@tiptap/extension-table-row": "^3.20.4",
    "@tiptap/extension-task-item": "^3.20.4",
    "@tiptap/extension-task-list": "^3.20.4",
    "@tiptap/extension-text": "^3.20.4",
    "@tiptap/extension-text-align": "^3.20.4",
    "@tiptap/extensions": "^3.20.4",
    "@tiptap/pm": "^3.20.4",
    "@tiptap/react": "^3.20.4",
    "classnames": "^2.5.1",
    "highlight.js": "^11.9.0",
    "lowlight": "2.9.0",
    "lucide-react": "^0.542.0",
    "tiptap-markdown": "^0.8.10"
  },
  "devDependencies": {
    "@allahbin/eslint": "^0.0.6",
    "@commitlint/cli": "^17.1.2",
    "@commitlint/config-conventional": "^17.1.0",
    "@types/react": "^18.2.79",
    "@umijs/lint": "^4.0.0",
    "dumi": "^2.0.0-rc.0",
    "eslint": "^8.23.0",
    "father": "^4.1.0",
    "gh-pages": "^6.1.1",
    "husky": "^8.0.1",
    "lint-staged": "^13.0.3",
    "prettier": "^2.7.1",
    "prettier-plugin-organize-imports": "^3.0.0",
    "prettier-plugin-packagejson": "^2.2.18",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-json-view": "^1.21.3",
    "stylelint": "14.16.1"
  },
  "peerDependencies": {
    "lowlight": "2.9.0",
    "react": ">=16.9.0",
    "react-dom": ">=16.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "authors": [
    "allahbin <16008@theling.cn>"
  ]
}
