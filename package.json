{
  "name": "@allahbin/tiptap",
  "version": "2.2.8",
  "description": "基于tiptap的中文文章编辑器",
  "homepage": "https://github.com/Tzng/allahbin-tiptap",
  "license": "MIT",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "father build",
    "build:watch": "father dev",
    "deploy": "gh-pages -d docs-dist",
    "dev": "dumi dev",
    "docs:build": "dumi build",
    "doctor": "father doctor",
    "lint": "npm run lint:es && npm run lint:css",
    "lint:css": "stylelint \"{src,test}/**/*.{css,less}\"",
    "lint:es": "eslint \"{src,test}/**/*.{js,jsx,ts,tsx}\"",
    "prepare": "husky && dumi setup",
    "prepublishOnly": "father doctor && npm run build",
    "publishNpm": "father doctor && npm run build && npm publish --access public --registry=https://registry.npmjs.org/",
    "start": "npm run dev"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*.{md,json}": [
      "prettier --write --no-error-on-unmatched-pattern"
    ],
    "*.{css,less}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --parser=typescript --write"
    ]
  },
  "resolutions": {
    "@tiptap/core": "3.30.1",
    "@tiptap/pm": "3.30.1",
    "@tiptap/react": "3.30.1",
    "lowlight": "3.3.0"
  },
  "dependencies": {
    "@floating-ui/react": "0.27.20",
    "@tippyjs/react": "4.2.6",
    "@tiptap/core": "3.30.1",
    "@tiptap/extension-blockquote": "3.30.1",
    "@tiptap/extension-bold": "3.30.1",
    "@tiptap/extension-bubble-menu": "3.30.1",
    "@tiptap/extension-code": "3.30.1",
    "@tiptap/extension-code-block": "3.30.1",
    "@tiptap/extension-code-block-lowlight": "3.30.1",
    "@tiptap/extension-document": "3.30.1",
    "@tiptap/extension-drag-handle": "3.30.1",
    "@tiptap/extension-drag-handle-react": "3.30.1",
    "@tiptap/extension-file-handler": "3.30.1",
    "@tiptap/extension-find-and-replace": "3.30.1",
    "@tiptap/extension-hard-break": "3.30.1",
    "@tiptap/extension-heading": "3.30.1",
    "@tiptap/extension-highlight": "3.30.1",
    "@tiptap/extension-horizontal-rule": "3.30.1",
    "@tiptap/extension-image": "3.30.1",
    "@tiptap/extension-italic": "3.30.1",
    "@tiptap/extension-link": "3.30.1",
    "@tiptap/extension-list": "3.30.1",
    "@tiptap/extension-node-range": "3.30.1",
    "@tiptap/extension-paragraph": "3.30.1",
    "@tiptap/extension-strike": "3.30.1",
    "@tiptap/extension-table": "3.30.1",
    "@tiptap/extension-table-cell": "3.30.1",
    "@tiptap/extension-table-header": "3.30.1",
    "@tiptap/extension-table-row": "3.30.1",
    "@tiptap/extension-text": "3.30.1",
    "@tiptap/extension-text-align": "3.30.1",
    "@tiptap/extension-underline": "3.30.1",
    "@tiptap/extensions": "3.30.1",
    "@tiptap/pm": "3.30.1",
    "@tiptap/react": "3.30.1",
    "@tiptap/suggestion": "3.30.1",
    "classnames": "2.5.1",
    "highlight.js": "11.12.0",
    "lowlight": "3.3.0",
    "lucide-react": "1.31.0",
    "tiptap-markdown": "0.9.0"
  },
  "devDependencies": {
    "@allahbin/eslint": "0.0.6",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@umijs/lint": "4.7.5",
    "antd": "5.29.3",
    "dumi": "2.4.49",
    "eslint": "8.57.1",
    "father": "4.6.36",
    "gh-pages": "6.3.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-packagejson": "3.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stylelint": "14.16.1"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "authors": [
    "allahbin <16008@theling.cn>"
  ]
}
